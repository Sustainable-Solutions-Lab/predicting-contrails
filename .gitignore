# Python
__pycache__/
*.pyc
*.pyo
.venv/
.env

# Large data — kept in Dropbox, not in git
*.parquet
*.pq
*.nc

# OS
.DS_Store

# Editor
.vscode/
.idea/

# Run logs (regeneratable)
experiments/outputs/*.log
experiments/outputs/_*.parquet
figures/*.log

# Trained model artifacts (regeneratable, can be large)
*.joblib
*.pkl

# Whitelist the small experiment outputs we DO want tracked
!experiments/outputs/*.csv
!experiments/outputs/*.png

# webtool model exports (rebuilt by webtool/export_assets.py; deployed copy lives in the website repo)
webtool/assets/*.ubj
webtool/assets/land_union.wkb

# Manuscript drafts and draft builders (private; live in Dropbox only)
manuscript/
experiments/validation/make_claude_draft.py
*.docx
*.doc
